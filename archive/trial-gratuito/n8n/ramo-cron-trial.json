    {
      "parameters": {
        "jsCode": "// Avisa so no dia final do trial (o dia local BR anterior a trial_fim,\n// ja que trial_fim e meia-noite BRT = inicio do dia seguinte ao ultimo dia util).\n// Nunca duas vezes no mesmo dia (ultimo_aviso_trial != hoje).\nconst BR_OFFSET_MS = -3 * 60 * 60 * 1000;\nfunction dataLocalBR(date) {\n  return new Date(date.getTime() + BR_OFFSET_MS).toISOString().slice(0, 10);\n}\n\nconst hoje = dataLocalBR(new Date());\nconst results = [];\n\nfor (const item of $input.all()) {\n  const c = item.json;\n  if (!c || !c.trial_fim) continue;\n\n  const umDiaAntesDoFim = new Date(new Date(c.trial_fim).getTime() - 24 * 60 * 60 * 1000);\n  const diaFinal = dataLocalBR(umDiaAntesDoFim);\n  if (hoje !== diaFinal) continue;\n  if (c.ultimo_aviso_trial === hoje) continue;\n\n  results.push({ json: { ...c, hoje } });\n}\n\nreturn results;"
      },
      "id": "c0b2fabc-2f31-47da-b12e-e370630894ee",
      "name": "Filtrar Aviso Último Dia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        432
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.uazapi_server + '/send/text' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "={{ $json.uazapi_token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.telefone_operador, text: 'Oi! Hoje é o último dia do seu teste grátis da Recepta AI — expira à meia-noite.\\n\\nPra continuar:\\nMensal R$497/mês: ' + $('Config Fixa').item.json.stripe_link_mensal + '?client_reference_id=' + $json.id + '\\n\\nOu economize no anual, R$347/mês (R$4.164 à vista no ano): ' + $('Config Fixa').item.json.stripe_link_anual + '?client_reference_id=' + $json.id }) }}",
        "options": {}
      },
