      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"persona\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"nome_ia\": { \"type\": \"string\" },\n        \"tom\": { \"type\": \"string\" },\n        \"tratamento_paciente\": { \"type\": \"string\" },\n        \"uso_emoji\": { \"type\": \"string\" },\n        \"saudacao_abertura\": { \"type\": \"string\" },\n        \"pode_revelar_que_e_ia\": { \"type\": \"string\" },\n        \"resposta_identidade\": { \"type\": \"string\" },\n        \"vocabulario_preferido\": { \"type\": \"string\" },\n        \"vocabulario_evitar\": { \"type\": \"string\" }\n      },\n      \"required\": [\"nome_ia\", \"tom\", \"saudacao_abertura\"]\n    },\n    \"conhecimento\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"servicos_oferecidos\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"servicos_mais_procurados\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"nao_realiza\": { \"type\": \"string\" },\n        \"convenios\": { \"type\": \"string\" },\n        \"atende_particular\": { \"type\": \"string\" },\n        \"pode_informar_preco\": { \"type\": \"string\" },\n        \"tabela_precos\": { \"type\": \"string\" },\n        \"formas_pagamento\": { \"type\": \"string\" },\n        \"preparo_exames\": { \"type\": \"string\" },\n        \"documentos_levar\": { \"type\": \"string\" },\n        \"antecedencia_chegada\": { \"type\": \"string\" },\n        \"regras_acompanhante\": { \"type\": \"string\" }\n      }\n    },\n    \"agendamento\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"sistema_usado\": { \"type\": \"string\" },\n        \"papel_da_ia\": { \"type\": \"string\" },\n        \"dados_obrigatorios\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"horarios_disponiveis\": { \"type\": \"string\" },\n        \"duracao_atendimento\": { \"type\": \"string\" },\n        \"antecedencia_minima\": { \"type\": \"string\" },\n        \"regras_remarcacao_cancelamento\": { \"type\": \"string\" },\n        \"fila_espera\": { \"type\": \"string\" }\n      }\n    },\n    \"faq\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"pergunta\": { \"type\": \"string\" },\n          \"resposta\": { \"type\": \"string\" }\n        }\n      }\n    },\n    \"escalonamento\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"nunca_fazer\": { \"type\": \"array\", \"items\": { \"type\": \"string\" } },\n        \"sempre_escalar_para_humano\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"whatsapp_alerta\": { \"type\": \"string\" },\n        \"horario_humano_disponivel\": { \"type\": \"string\" },\n        \"mensagem_fora_do_horario\": { \"type\": \"string\" },\n        \"resposta_emergencia_medica\": { \"type\": \"string\" }\n      }\n    },\n    \"system_prompt\": { \"type\": \"string\" }\n  },\n  \"required\": [\n    \"persona\",\n    \"conhecimento\",\n    \"agendamento\",\n    \"escalonamento\",\n    \"system_prompt\"\n  ]\n}"
      },
      "id": "050010f9-3f78-4636-8375-6b5db7558332",
