    {
      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst sigHeader = headers['stripe-signature'] || '';\nconst parts = Object.fromEntries(sigHeader.split(',').filter(Boolean).map(p => { const [k, v] = p.split('='); return [k, v]; }));\nconst timestamp = parts.t || '';\nconst receivedSignature = parts.v1 || '';\n\nconst buf = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst rawBody = buf.toString('utf8');\n\nconst fiveMinutes = 5 * 60;\nconst isRecent = timestamp ? Math.abs((Date.now() / 1000) - Number(timestamp)) < fiveMinutes : false;\n\nreturn [{ json: { signed_payload: timestamp + '.' + rawBody, received_signature: receivedSignature, is_recent: isRecent, raw_body: rawBody } }];"
      },
